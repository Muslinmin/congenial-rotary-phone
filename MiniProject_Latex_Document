    Serial.print(pitchT, 2); Serial.print(",");
    Serial.print(rollT, 2); Serial.print(",");
    Serial.print("FFF");  // End transmission header
}

void setup() {
  cal.valid = false;  // Calibration data initially invalid
  Serial.begin(9600);  // Start serial communication
  Wire.begin();  // Initialize I2C communication
  Wire.setClock(400000);  // Set I2C clock to 400kHz

  delay(2000);  // Give sensors time to initialize

  int err = mpu.init(cal, 0x68);  // Initialize MPU6500
  if (err != 0) {
    while (true);  // Stop execution if initialization fails
  }
  mpu.calibrateAccelGyro(&cal);  // Perform calibration
  mpu.init(cal, 0x68);  // Reinitialize with calibration data

  // Attach servos to control pins
  aileronLeft.attach(aileronLeftPin);
  aileronRight.attach(aileronRightPin);
  elevatorLeft.attach(elevatorLeftPin);
  elevatorRight.attach(elevatorRightPin);
}

