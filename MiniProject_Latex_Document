// Initialize previous servo angles
int prevAileronLeftAngle = 90;
int prevAileronRightAngle = 90;
int prevElevatorLeftAngle = 90;
int prevElevatorRightAngle = 90;

class Kalman {
public:
  float Q_angle;   // Process noise variance for the angle
  float Q_bias;    // Process noise variance for the gyroscope bias
  float R_measure; // Measurement noise variance (accelerometer)

  float angle;     // Kalman filter's angle estimate
  float bias;      // Bias estimated by the Kalman filter
  float rate;      // Unbiased rate (gyro rate - bias)

  float P[2][2];   // Error covariance matrix

  Kalman() {
    Q_angle = 0.0025f;  // Initial process noise variance for the angle
    Q_bias = 0.003f;    // Initial process noise variance for gyroscope bias
    R_measure = 0.03f;  // Measurement noise variance

    angle = 0.0f;  // Initialize angle estimate
    bias = 0.0f;   // Initialize bias estimate
    rate = 0.0f;   // Initialize unbiased rate

    // Initialize error covariance matrix P
    P[0][0] = 0.0f;
    P[0][1] = 0.0f;
    P[1][0] = 0.0f;
    P[1][1] = 0.0f;
  }

  float getAngle(float newAngle, float newRate, float dt) {
    // Predict phase
    rate = newRate - bias;  // Subtract bias from the new gyroscope rate
    angle += dt * rate;     // Update angle estimate with rate * time

    // Update error covariance matrix
    P[0][0] += dt * (dt * P[1][1] - P[0][1] - P[1][0] + Q_angle);
    P[0][1] -= dt * P[1][1];
    P[1][0] -= dt * P[1][1];
    P[1][1] += Q_bias * dt;

    // Measurement update phase
    float S = P[0][0] + R_measure;  // Calculate innovation covariance
    float K[2];  // Kalman gain
    K[0] = P[0][0] / S;
    K[1] = P[1][0] / S;

    float y = newAngle - angle;  // Innovation (measurement - prediction)
    angle += K[0] * y;  // Update angle estimate
    bias += K[1] * y;   // Update bias estimate

    // Update the error covariance matrix
    float P00_temp = P[0][0];
    float P01_temp = P[0][1];
    P[0][0] -= K[0] * P00_temp;
    P[0][1] -= K[0] * P01_temp;
    P[1][0] -= K[1] * P00_temp;
    P[1][1] -= K[1] * P01_temp;

    return angle;  // Return the filtered angle
  }
};



// Transmit data to MATLAB
void transmitToMatLab(float pitchT, float rollT) {
    Serial.print("111");  // Start transmission header
    // Transmit accelerometer and gyroscope data as comma-separated values
    Serial.print(accelOut.accelX, 2); Serial.print(",");
    Serial.print(accelOut.accelY, 2); Serial.print(",");
